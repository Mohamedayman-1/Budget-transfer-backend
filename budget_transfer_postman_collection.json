{
  "info": {
    "name": "Budget Transfer API",
    "description": "API collection for Budget Transfer application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"test_user\",\n    \"password\": \"securepassword123\",\n    \"first_name\": \"Test\",\n    \"last_name\": \"User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = JSON.parse(responseBody);",
                  "pm.environment.set(\"access_token\", jsonData.access);",
                  "pm.environment.set(\"refresh_token\", jsonData.refresh);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"test_user\",\n    \"password\": \"securepassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Budget Management",
      "item": [
        {
          "name": "Create Budget Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": 5000,\n    \"from_code\": \"BUDGET001\",\n    \"to_code\": \"BUDGET002\",\n    \"description_x\": \"Budget transfer for Q3 expenses\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/budget/transfers/",
              "host": ["{{base_url}}"],
              "path": ["api", "budget", "transfers", ""]
            }
          }
        },
        {
          "name": "List Budget Transfers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/budget/transfers/?page=1&page_size=10&code=BUDGET001&requested_by=test_user",
              "host": ["{{base_url}}"],
              "path": ["api", "budget", "transfers", ""],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                },
                {
                  "key": "code",
                  "value": "BUDGET001",
                  "disabled": true
                },
                {
                  "key": "requested_by",
                  "value": "test_user",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Budget Transfer Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/budget/transfers/{{transfer_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "budget", "transfers", "{{transfer_id}}", ""]
            }
          }
        },
        {
          "name": "Approve/Reject Budget Transfer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"action\": \"approve\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/budget/transfers/{{transfer_id}}/approve/",
              "host": ["{{base_url}}"],
              "path": ["api", "budget", "transfers", "{{transfer_id}}", "approve", ""]
            }
          }
        }
      ]
    },
